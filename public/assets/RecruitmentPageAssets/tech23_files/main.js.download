const handleOptionsTag=(expt)=>{
    if(optionsTag.innerHTML!=''){optionsTag.innerHTML=''}
    expertiseOpt[expt].map((opt,id)=>{
        optionsTag.innerHTML+=`<div>
        <input type="radio" name="experties" id="opt1" } onclick="setImages()" value=${opt.split(' ').join('')} >
        <label for="opt1">${opt}</label>
        </div>`
    })
}
handleOptionsTag('Tech')
toggleButton.children[0].addEventListener('click',()=>{
    toggleButton.children[0].style.backgroundColor='white'
    toggleButton.children[0].style.color='rgb(5,44,100)'
    toggleButton.children[1].style.backgroundColor='rgb(5,44,100)'
    toggleButton.children[1].style.color='white'
})
toggleButton.children[1].addEventListener('click',()=>{
    toggleButton.children[1].style.backgroundColor='white'
    toggleButton.children[1].style.color='rgb(5,44,100)'
    toggleButton.children[0].style.backgroundColor='rgb(5,44,100)'
    toggleButton.children[0].style.color='white'
})

toggleButton.firstElementChild.style.backgroundColor='white'
toggleButton.firstElementChild.style.color='rgb(5,44,100)'

toggleButton.firstElementChild.addEventListener('click',function(){
    expertise="Tech"
    handleOptionsTag('Tech')
    document.getElementsByName('experties')[0].checked=true;
    setImages();
})
toggleButton.children[1].addEventListener('click',function(){
    expertise='NonTech'
    handleOptionsTag('NonTech')
    document.getElementsByName('experties')[0].checked=true;
    setImages();
})

const setImages=()=>{
    const checkedValue=document.querySelector('input[name="experties"]:checked').value;
    if(Box.innerHTML!=''){Box.innerHTML=``}
    if(expertise=='Tech'){
        images[checkedValue].map((imgURL)=>{
            Box.innerHTML+=`
            <div>
            <img src="./media/logos/${imgURL}.png" alt="">
            <p>${imgURL}</p>
            </div>
            `
        })
    }
    else{
        textNonTech[checkedValue].map((text)=>{
            Box.innerHTML+=`
              <div class="exptText">
              <p  >${text}</p>
              </div>`
            })
        }
    }

document.getElementsByName('experties')[0].checked=true;
setImages()    




